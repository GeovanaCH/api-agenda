                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "agendado",
                                        "enum": [
                                            "agendado",
                                            "concluido",
                                            "cancelado"
                                        ]
                                    },
                                    "assunto": {
                                        "type": "string",
                                        "example": "Primeira consulta"
                                    },
                                    "observacoes": {
                                        "type": "string",
                                        "example": "Trazer documentos",
