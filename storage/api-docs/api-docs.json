                        "type": "string",
                        "format": "email",
                        "example": "ana@example.com"
                    },
                    "cpf": {
                        "type": "string",
                        "example": "52998224725"
                    },
                    "telefone": {
                        "type": "string",
                        "example": "(11) 98888-7777",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Atendimento": {
                "required": [
